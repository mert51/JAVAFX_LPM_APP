<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="190.0" prefWidth="369.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sau.lpm.lpm_p1.controller.StudentController">
    <children>
        <Label layoutX="26.0" layoutY="20.0" text="ID:" />
        <Label layoutX="26.0" layoutY="50.0" text="NAME:" />
        <Label layoutX="26.0" layoutY="79.0" text="DEPARTMENT:" />
        <TextField fx:id="studentId" layoutX="89.0" layoutY="16.0" />
        <TextField fx:id="name" layoutX="89.0" layoutY="46.0" />
        <TextField fx:id="department" layoutX="89.0" layoutY="76.0" />
        <Button fx:id="getStudent" layoutX="249.0" layoutY="38.0" mnemonicParsing="false" onAction="#getStudent" text="GET" />
        <Button fx:id="updateStudent" layoutX="89.0" layoutY="126.0" mnemonicParsing="false" onAction="#updateStudent" text="UPDATE" />
        <Button fx:id="saveStudent" layoutX="34.0" layoutY="126.0" mnemonicParsing="false" onAction="#saveStudent" text="SAVE" />
        <Button fx:id="deleteStudent" layoutX="164.0" layoutY="125.0" mnemonicParsing="false" onAction="#deleteStudent" text="DELETE" />
        <Button fx:id="close" layoutX="242.0" layoutY="126.0" mnemonicParsing="false" onAction="#close" text="CLOSE" />
        <Button fx:id="clearStudent" layoutX="242.0" layoutY="83.0" mnemonicParsing="false" onAction="#clearStudent" text="CLEAR" />
    </children>
</AnchorPane>
